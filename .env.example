# Local PostgreSQL in Docker
POSTGRES_DB=strona_qr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring Boot
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Optional Supabase override (if set, backend will use Supabase instead of local db host)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>
